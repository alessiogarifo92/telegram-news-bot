# Bot token, from @BotFather (the /newbot command).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# YOUR numeric Telegram ID (where the digest gets delivered every day).
# To find it: message @userinfobot on Telegram, or send /start to your new
# bot and read the ID from the logs of the first run.
TELEGRAM_CHAT_ID=123456789

# How far back to look for a feed entry to still count as "new".
# 30 and not 24 on purpose: the GitHub Actions scheduler drifts and now and
# then skips a run entirely, and the 6 hours of overlap cover that gap.
# Already-sent stories do not come back, because the persistent dedup state
# filters them out (see SENT_STATE_FILE). If you turn that state off, put
# this back to 24.
HOURS_LOOKBACK=30

# Where to remember the stories already sent, so they are not repeated on
# the next run, and for how many days to remember them. On GitHub Actions
# this file survives between runs thanks to actions/cache; locally it just
# lives in the project folder and is gitignored.
SENT_STATE_FILE=.state/sent.json
SENT_STATE_TTL_DAYS=7

# Maximum number of stories per category, applied after deduplication.
# Every story becomes its own Telegram message, and there are 12 sources
# configured, so a high value here means a lot of messages every day.
MAX_ITEMS_PER_CATEGORY=3

# How similar two titles must be (0-1) before the second one is treated as
# a duplicate of the first. Lower = more aggressive filtering. Below ~0.4
# it starts discarding unrelated stories that merely share common words.
DUPLICATE_TITLE_THRESHOLD=0.6

# Pause between one Telegram message and the next, in seconds. Keeps the
# bot from being throttled by Telegram's rate limit when sending many
# messages in a row. Do not go below 0.5.
SECONDS_BETWEEN_MESSAGES=1.0

# (Optional) Free DeepL API key, used as the third fallback for NL->EN
# translation when Google Translate and MyMemory both fail (those two are
# free but share public quotas that run out from time to time). To get one:
# go to https://www.deepl.com/pro#developer and create a free "DeepL API
# Free" account (no credit card required), then copy the key from there.
# 500,000 characters/month for free.
# Leave empty to skip this fallback — the bot still works, and sends the
# original Dutch title if no translation succeeds.
DEEPL_API_KEY=

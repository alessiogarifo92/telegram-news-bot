# Token del bot, da @BotFather (comando /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Il TUO ID numerico Telegram (dove arriverà il digest ogni giorno).
# Per trovarlo: scrivi a @userinfobot su Telegram, oppure scrivi /start
# al tuo nuovo bot e guarda l'ID nei log del primo tentativo.
TELEGRAM_CHAT_ID=123456789

# Quante ore indietro guardare per considerare una notizia "nuova".
# 30 e non 24 apposta: lo scheduler di GitHub Actions slitta e ogni tanto
# salta un giro, e le 6 ore di sovrapposizione coprono il buco. Le notizie
# gia' mandate non tornano perche' le filtra lo stato persistente della
# deduplicazione (.state/sent.json). Se disattivi quello stato, rimetti 24.
HOURS_LOOKBACK=30

# Dove tenere memoria delle notizie gia' mandate, per non ripeterle al run
# successivo, e per quanti giorni ricordarle. Su GitHub Actions il file
# sopravvive tra un run e l'altro grazie ad actions/cache.
SENT_STATE_FILE=.state/sent.json
SENT_STATE_TTL_DAYS=7

# Massimo numero di notizie per categoria. Ogni notizia diventa un
# messaggio Telegram separato: con 8 fonti configurate, un valore alto
# qui genera molti messaggi al giorno. 5 è un buon compromesso.
MAX_ITEMS_PER_CATEGORY=5

# Pausa tra un messaggio Telegram e il successivo, in secondi. Evita di
# essere rallentato dal rate limit di Telegram quando si mandano molti
# messaggi di fila. Non scendere sotto 0.5.
SECONDS_BETWEEN_MESSAGES=1.0

# (Opzionale) API key gratuita di DeepL, usata come terzo fallback per la
# traduzione NL->EN quando Google Translate e MyMemory falliscono (i due
# motori gratuiti principali hanno quote condivise che a volte si
# esauriscono). Per ottenerla: vai su https://www.deepl.com/pro#developer,
# crea un account gratuito "DeepL API Free" (nessuna carta di credito
# richiesta), copia la key da lì. 500.000 caratteri/mese gratis.
# Lascia vuoto per saltare questo fallback (il bot funziona comunque,
# manda il titolo originale in olandese se nessuna traduzione riesce).
DEEPL_API_KEY=

